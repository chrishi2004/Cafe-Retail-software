# Authenticated owner, Retail, and Cafe portals use the full Local Hub API.
VITE_OPERATIONAL_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# Customer continuity and sanitized cloud routes use the restricted gateway.
# Never put database passwords, device secrets, or Supabase service-role keys here.
VITE_CLOUD_API_BASE_URL=https://cloud-api.example.com/api

[Unit]
Description=Kalpvrik Cafe Cloud Menu Publisher
After=network-online.target postgresql.service kalpvrik-api.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=kalpvrik
Group=kalpvrik
WorkingDirectory=/opt/kalpvrik/backend
EnvironmentFile=/etc/kalpvrik/local-hub.env
ExecStart=/opt/kalpvrik/backend/.venv/bin/python -m scripts.publish_cafe_menu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kalpvrik /var/log/kalpvrik

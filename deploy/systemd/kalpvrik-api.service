[Unit]
Description=Kalpvrik Local Hub FastAPI
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=kalpvrik
Group=kalpvrik
WorkingDirectory=/opt/kalpvrik/backend
EnvironmentFile=/etc/kalpvrik/local-hub.env
ExecStart=/opt/kalpvrik/backend/.venv/bin/uvicorn operational_server:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kalpvrik /var/log/kalpvrik

[Install]
WantedBy=multi-user.target

# Copy to /etc/kalpvrik/local-hub.env and replace both placeholders.
# Keep this file readable only by root and group kalpvrik (0640).
KALPVRIK_PROFILE=cafe-v1
KALPVRIK_ENV_FILE=/etc/kalpvrik/local-hub.env
KALPVRIK_DATA_DIR=/var/lib/kalpvrik
KALPVRIK_BACKUP_RETENTION_DAYS=30
ENVIRONMENT=production
DEPLOYMENT_MODE=local_hub
LOCAL_DATABASE_URL=postgresql+psycopg://cafe_app:REPLACE_PASSWORD@127.0.0.1:5432/kalpvrik_cafe
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
REQUIRE_PRIVILEGED_MFA=true
API_DOCS_ENABLED=false
FRONTEND_ORIGIN=http://127.0.0.1:4173
FRONTEND_EXTRA_ORIGINS=
# No cloud URL, sync credential, menu publication or AI key is needed.

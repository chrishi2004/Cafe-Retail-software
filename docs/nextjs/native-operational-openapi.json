          "200": {
            "description": "Scoped audit data"
          },
          "403": {
            "description": "Owner permission required"
          }
        }
      }
    },
    "/api/exports/history/sales": {
      "get": {
        "tags": [
          "historical exports"
        ],
        "summary": "Download sales as a scoped CSV",
        "responses": {
          "200": {
            "description": "UTF-8 CSV for the selected scope and IST dates",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient venture or branch access"
          }
        }
      }
    },

    "/api/audit/events": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Read or export the owner audit history",
        "responses": {
          "200": {
            "description": "Scoped audit data"
          },
          "403": {
            "description": "Owner permission required"
          }
        }
      }
    },
    "/api/audit/options": {
      "get": {
        "tags": [
          "audit"
        ],

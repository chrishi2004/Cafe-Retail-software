# New isolated web database only; never the installed Cafe database.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kalpvriksh_web_staging
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Browser operational and public Cafe requests are intentionally same-origin (/api).
# Do not configure legacy NEXT_PUBLIC_* API base URLs for the hosted web application.
# Required for one-time NEW database bootstrap; keep outside Git.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_CAFE_CASHIER_EMAIL=
BOOTSTRAP_CAFE_CASHIER_PASSWORD=
BOOTSTRAP_RETAIL_CASHIER_EMAIL=
BOOTSTRAP_RETAIL_CASHIER_PASSWORD=
